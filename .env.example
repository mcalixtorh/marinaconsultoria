# Variáveis da Vercel (Settings › Environment Variables). Nada disto é obrigatório para o app básico.

# --- no navegador (começam com VITE_) ---
# mostrar a caixa do Assistente de IA em Meu dia (só depois de cadastrar ANTHROPIC_API_KEY)
VITE_ASSISTANT=

# --- só no servidor (NUNCA com VITE_) ---
# senha do app: protege as funções /api (assistente, Google Agenda, avisos)
ASSISTANT_PASSCODE=
# Google Agenda (somente leitura): endereço secreto no formato iCal
ICAL_URL=
# Avisos com o app fechado + cópia na nuvem (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_SUBJECT=mailto:
# Assistente de IA (pago, opcional)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
